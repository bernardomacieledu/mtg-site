# ─── Banco de dados ──────────────────────────────────────────────────────────
DB_NAME=mtg_db
DB_USER=mtg_ingest
DB_PASSWORD=mtgpass
MYSQL_ROOT_PASSWORD=rootpass
# Porta do MySQL exposta no host (3307 evita conflito com um MySQL local)
DB_PORT_HOST=3307

# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
JWT_SECRET=troque-este-segredo-em-producao
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
API_PORT=8000

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONT_PORT=8080
# Deixe vazio para usar o proxy /api do nginx (recomendado no localhost)
VITE_API_URL=

# ─── Carga inicial de cartas (Scryfall) ──────────────────────────────────────
SEED_ON_START=1
SEED_RECENT_SETS=8
