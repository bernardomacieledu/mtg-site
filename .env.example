# ─── Banco de dados ──────────────────────────────────────────────────────────
# Usa o MariaDB/MySQL já instalado na máquina host, não um container.
# Veja "Usando o MariaDB do host" no README antes de subir pela primeira vez.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=mtg_db
DB_USER=mtg_ingest
DB_PASSWORD=mtgpass

# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
JWT_SECRET=troque-este-segredo-em-producao
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
API_PORT=8000
ADMIN_PASSWORD=suasenha

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONT_PORT=8080

# Adminer (acesso ao banco pelo navegador em http://localhost:8081)
# Servidor: db | Usuario/Senha: os mesmos DB_USER/DB_PASSWORD | Base: mtg_db
ADMINER_PORT=8081
ADMINER_DESIGN=dracula
# Deixe vazio para usar o proxy /api do nginx (recomendado no localhost)
VITE_API_URL=

# ─── Carga inicial de cartas (Scryfall) ──────────────────────────────────────
SEED_ON_START=1
# Quantas coleções mais recentes importar no primeiro boot.
# Mantenha baixo aqui (o boot fica rápido) e depois rode, para pegar tudo:
#   docker compose exec api python manage.py seed_cards --bulk
SEED_RECENT_SETS=8
# Tempo máximo de espera pelo banco antes de desistir com erro claro
DB_WAIT_TIMEOUT=180

# Importa precos do MTGJSON no boot (demorado: baixa AllPricesToday.json).
# Prefira rodar manualmente: docker compose exec api python manage.py seed_prices
SEED_PRICES=0

# ─── Administrador ───────────────────────────────────────────────────────────
# Com ADMIN_PASSWORD preenchida, o superusuario e criado/atualizado no boot.
# Painel em http://localhost:8000/admin/
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@localhost

# Agendador: intervalo entre verificacoes, em segundos
SCHEDULER_INTERVAL=60

# Cotacao USD->BRL usada quando a consulta ao cambio falha (0 = sem conversao).
# Os precos em real sao ESTIMATIVA convertida do dolar: o mercado brasileiro
# tem dinamica propria e costuma divergir da conversao direta.
USD_BRL_FALLBACK=0
